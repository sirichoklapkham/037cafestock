/**
 * 1. ฟังก์ชัน doGet: ส่งข้อมูลสินค้า หมวดหมู่ และส่ง URL ในคอลัมน์ H2 กลับมาให้อัตโนมัติ
 */
function doGet(e) {
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    const data = sheet.getDataRange().getValues();
    
    // ดึงค่า URL จากคอลัมน์ H (แถวที่ 2 หรือ H2)
    let webAppUrl = "";
    if (data.length > 1 && data[1].length >= 8) {
      webAppUrl = String(data[1][7] || '').trim();
    }

    if (data.length <= 1) {
      const emptyResponse = { items: [], categories: [], webAppUrl: webAppUrl };
      return ContentService.createTextOutput(JSON.stringify(emptyResponse))
        .setMimeType(ContentService.MimeType.JSON);
    }

    const rows = data.slice(1);
    var categoriesSet = new Set();
    const items = [];

    rows.forEach(function(row, index) {
      const code = String(row[0] || '').trim();
      const name = String(row[1] || '').trim();
      
      if (code || name) {
        const catName = String(row[5] || '').trim() || 'ทั่วไป';
        categoriesSet.add(catName);

        items.push({
          id: index + 1,
          code: code,
          name: name,
          stock: Number(row[2]) || 0,
          minAlert: Number(row[3]) || 0,
          unit: String(row[4] || 'ชิ้น').trim(),
          categoryName: catName,
          lastCost: Number(row[6]) || 0
        });
      }
    });

    var categories = Array.from(categoriesSet).map(function(catName, index) {
      return { id: index + 1, name: catName };
    });

    // คืนค่า JSON รวมทั้ง webAppUrl
    const response = {
      items: items,
      categories: categories,
      webAppUrl: webAppUrl
    };
    
    return ContentService.createTextOutput(JSON.stringify(response))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: err.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

/**
 * 2. ฟังก์ชัน doPost: รองรับ Action ต่างๆ และบันทึก URL ลง คอลัมน์ H2
 */
function doPost(e) {
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    const contents = e.postData.contents;
    const data = JSON.parse(contents);
    const action = data.action || 'saveItem';

    // Action: บันทึก/อัปเดต Google Script Web App URL ลงคอลัมน์ H (H2)
    if (action === 'updateScriptUrl') {
      const newUrl = String(data.scriptUrl || '').trim();
      if (newUrl) {
        // กำหนดหัวข้อคอลัมน์ H1 และบันทึก URL ที่ H2
        sheet.getRange(1, 8).setValue("Web App URL");
        sheet.getRange(2, 8).setValue(newUrl);
      }
      return ContentService.createTextOutput(JSON.stringify({ 
        status: "success", 
        message: "บันทึก Script URL ลงคอลัมน์ H2 เรียบร้อยแล้ว",
        webAppUrl: newUrl
      })).setMimeType(ContentService.MimeType.JSON);
    }

    // Action: ทดสอบส่ง LINE
    if (action === 'testLine') {
      const testMsg = `🔔 [ทดสอบระบบแจ้งเตือน LINE]\nระบบเชื่อมต่อ Google Sheet & LINE API สำเร็จเรียบร้อยแล้ว!\nเวลาทดสอบ: ${new Date().toLocaleString('th-TH')}`;
      const success = sendLinePushMessage(testMsg);
      return ContentService.createTextOutput(JSON.stringify({ 
        status: success ? "success" : "error", 
        message: success ? "ส่งข้อความทดสอบ LINE สำเร็จ" : "ส่งข้อความไม่สำเร็จ" 
      })).setMimeType(ContentService.MimeType.JSON);
    }

    // Action: ปรับปรุงสต๊อกด่วน (Quick Adjust)
    if (action === 'quickAdjust') {
      const code = String(data.code || '').trim();
      const adjustType = data.type;
      const qty = Number(data.qty) || 0;
      const reason = data.reason || 'ปรับปรุงสต๊อก';
      
      const rows = sheet.getDataRange().getValues();
      let foundIndex = -1;
      let currentStock = 0;
      let itemObj = null;

      for (let i = 1; i < rows.length; i++) {
        if (String(rows[i][0]).trim() === code) {
          foundIndex = i + 1;
          currentStock = Number(rows[i][2]) || 0;
          itemObj = {
            name: String(rows[i][1]).trim(),
            code: code,
            minAlert: Number(rows[i][3]) || 0,
            unit: String(rows[i][4] || 'ชิ้น').trim()
          };
          break;
        }
      }

      if (foundIndex > 0 && itemObj) {
        let newStock = adjustType === 'ADD' ? currentStock + qty : currentStock - qty;
        if (newStock < 0) newStock = 0;
        sheet.getRange(foundIndex, 3).setValue(newStock);

        let msg = `🔄 [ปรับปรุงสต๊อกด่วน - ${adjustType === 'ADD' ? 'รับเข้า' : 'เบิกออก'}]\n`;
        msg += `สินค้า: ${itemObj.name} (${itemObj.code})\n`;
        msg += `จำนวนที่ปรับ: ${adjustType === 'ADD' ? '+' : '-'}${qty} ${itemObj.unit}\n`;
        msg += `คงเหลือใหม่: ${currentStock} ➔ ${newStock} ${itemObj.unit}\n`;
        msg += `เหตุผล: ${reason}\n`;

        if (newStock <= itemObj.minAlert) {
          msg += `⚠️ เตือน: สต๊อกต่ำกว่าเกณฑ์! (ขั้นต่ำ: ${itemObj.minAlert} ${itemObj.unit})`;
        }

        sendLinePushMessage(msg);
        return ContentService.createTextOutput(JSON.stringify({ status: "success" })).setMimeType(ContentService.MimeType.JSON);
      }
    }

    // Action: บันทึกการซื้อสินค้าเข้าสต๊อก (Purchase)
    if (action === 'purchase') {
      const code = String(data.code || '').trim();
      const qty = Number(data.qty) || 0;
      const unitCost = Number(data.unitCost) || 0;
      const supplier = data.supplier || '-';

      const rows = sheet.getDataRange().getValues();
      let foundIndex = -1;
      let currentStock = 0;
      let itemObj = null;

      for (let i = 1; i < rows.length; i++) {
        if (String(rows[i][0]).trim() === code) {
          foundIndex = i + 1;
          currentStock = Number(rows[i][2]) || 0;
          itemObj = {
            name: String(rows[i][1]).trim(),
            code: code,
            unit: String(rows[i][4] || 'ชิ้น').trim()
          };
          break;
        }
      }

      if (foundIndex > 0 && itemObj) {
        const newStock = currentStock + qty;
        sheet.getRange(foundIndex, 3).setValue(newStock);
        sheet.getRange(foundIndex, 7).setValue(unitCost);

        let msg = `🛒 [บันทึกการซื้อสินค้าเข้าสต๊อก]\n`;
        msg += `สินค้า: ${itemObj.name} (${itemObj.code})\n`;
        msg += `ซื้อเพิ่ม: +${qty} ${itemObj.unit} (ต้นทุน @${unitCost} ฿)\n`;
        msg += `รวมมูลค่า: ฿${(qty * unitCost).toLocaleString('th-TH')}\n`;
        msg += `คงเหลือสุทธิ: ${currentStock} ➔ ${newStock} ${itemObj.unit}\n`;
        msg += `ผู้ขาย/หมายเหตุ: ${supplier}`;

        sendLinePushMessage(msg);
        return ContentService.createTextOutput(JSON.stringify({ status: "success" })).setMimeType(ContentService.MimeType.JSON);
      }
    }

    // Action: ลบรายการสินค้า
    if (action === 'deleteItem') {
      const code = String(data.code || '').trim();
      const rows = sheet.getDataRange().getValues();
      for (let i = 1; i < rows.length; i++) {
        if (String(rows[i][0]).trim() === code) {
          const itemName = String(rows[i][1]).trim();
          sheet.deleteRow(i + 1);

          let msg = `🗑️ [ลบรายการสินค้า]\n`;
          msg += `สินค้า: ${itemName} (${code})\n`;
          msg += `สถานะ: ถูกลบออกจากระบบสต๊อกแล้ว`;

          sendLinePushMessage(msg);
          break;
        }
      }
      return ContentService.createTextOutput(JSON.stringify({ status: "success" })).setMimeType(ContentService.MimeType.JSON);
    }

    // Action: บันทึก/อัปเดตข้อมูลสินค้าทั่วไป
    const code = String(data.code || '').trim();
    const name = (typeof data.name === 'object' && data.name !== null) 
                 ? String(data.name.name || '').trim() 
                 : String(data.name || '').trim();
    const stock = Number(data.stock);
    const minAlert = Number(data.minAlert);
    const unit = String(data.unit || 'ชิ้น').trim();
    const categoryName = String(data.categoryName || data.category || 'ทั่วไป').trim();
    const lastCost = Number(data.lastCost) || 0;

    if (!code || !name || isNaN(stock) || isNaN(minAlert)) {
      return ContentService.createTextOutput(JSON.stringify({ 
        status: "error", 
        message: "ข้อมูลไม่ถูกต้องหรือส่งมาไม่ครบถ้วน" 
      })).setMimeType(ContentService.MimeType.JSON);
    }

    const rows = sheet.getDataRange().getValues();
    let foundIndex = -1;
    let oldStock = 0;
    
    for (let i = 1; i < rows.length; i++) {
      if (String(rows[i][0]).trim() === code) {
        foundIndex = i + 1;
        oldStock = Number(rows[i][2]) || 0;
        break;
      }
    }
    
    if (foundIndex > 0) {
      sheet.getRange(foundIndex, 1).setValue(code);
      sheet.getRange(foundIndex, 2).setValue(name);
      sheet.getRange(foundIndex, 3).setValue(stock);
      sheet.getRange(foundIndex, 4).setValue(minAlert);
      sheet.getRange(foundIndex, 5).setValue(unit);
      sheet.getRange(foundIndex, 6).setValue(categoryName);
      sheet.getRange(foundIndex, 7).setValue(lastCost);

      sendItemUpdateNotification(name, code, oldStock, stock, unit, minAlert, true);
    } else {
      const lastRow = sheet.getLastRow();
      sheet.getRange(lastRow + 1, 1).setValue(code);
      sheet.getRange(lastRow + 1, 2).setValue(name);
      sheet.getRange(lastRow + 1, 3).setValue(stock);
      sheet.getRange(lastRow + 1, 4).setValue(minAlert);
      sheet.getRange(lastRow + 1, 5).setValue(unit);
      sheet.getRange(lastRow + 1, 6).setValue(categoryName);
      sheet.getRange(lastRow + 1, 7).setValue(lastCost);
      
      sendItemUpdateNotification(name, code, 0, stock, unit, minAlert, false);
    }
    
    checkAndSendAllLowStock(sheet);
    
    return ContentService.createTextOutput(JSON.stringify({ status: "success" }))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: err.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

function sendItemUpdateNotification(name, code, oldStock, newStock, unit, minAlert, isUpdate) {
  let text = isUpdate ? `📝 [อัปเดตข้อมูลสินค้า]\n` : `➕ [เพิ่มสินค้าใหม่]\n`;
  text += `สินค้า: ${name} (${code})\n`;
  if (isUpdate) {
    text += `จำนวน: ${oldStock} ➔ ${newStock} ${unit}\n`;
  } else {
    text += `จำนวนเริ่มต้น: ${newStock} ${unit}\n`;
  }
  if (newStock <= minAlert) {
    text += `⚠️ เตือน: สต๊อกต่ำกว่าเกณฑ์! (เกณฑ์ขั้นต่ำ: ${minAlert} ${unit})`;
  }
  sendLinePushMessage(text);
}

function checkAndSendAllLowStock(sheet) {
  const targetSheet = sheet || SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const rows = targetSheet.getDataRange().getValues();
  const lowStockItems = [];

  for (let i = 1; i < rows.length; i++) {
    const itemCode = String(rows[i][0] || '').trim();
    const itemName = String(rows[i][1] || '').trim();
    const itemStock = Number(rows[i][2]);
    const itemMinAlert = Number(rows[i][3]);
    const itemUnit = String(rows[i][4] || 'ชิ้น').trim();

    if (itemName !== '' && !isNaN(itemStock) && !isNaN(itemMinAlert) && itemMinAlert > 0 && itemStock <= itemMinAlert) {
      lowStockItems.push({
        code: itemCode,
        name: itemName,
        stock: itemStock,
        minAlert: itemMinAlert,
        unit: itemUnit
      });
    }
  }

  if (lowStockItems.length > 0) {
    sendBatchLineNotification(lowStockItems);
  }
}

function sendBatchLineNotification(items) {
  let messageText = `⚠️ [แจ้งเตือนสินค้าสต๊อกต่ำทั้งหมด]\n`;
  messageText += `พบสินค้าเหลือน้อยจำนวน ${items.length} รายการ:\n`;
  messageText += `------------------------------------\n`;

  items.forEach((item, index) => {
    messageText += `${index + 1}. ${item.name} (${item.code})\n`;
    messageText += `   📦 คงเหลือ: ${item.stock} ${item.unit}\n`;
    messageText += `   🔔 เกณฑ์ต่ำ: ${item.minAlert} ${item.unit}\n`;
    if (index < items.length - 1) {
      messageText += `------------------------------------\n`;
    }
  });

  messageText += `\nกรุณาตรวจสอบและสั่งซื้อเพิ่มเติมครับ!`;
  sendLinePushMessage(messageText);
}

function sendLinePushMessage(textMessage) {
  const url = "https://api.line.me/v2/bot/message/push";
  const payload = {
    to: USER_ID,
    messages: [{ type: "text", text: textMessage }]
  };

  const options = {
    method: "post",
    contentType: "application/json",
    headers: { "Authorization": "Bearer " + LINE_ACCESS_TOKEN },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };

  try {
    const res = UrlFetchApp.fetch(url, options);
    return res.getResponseCode() === 200;
  } catch (err) {
    Logger.log("LINE Error: " + err.toString());
    return false;
  }
}
